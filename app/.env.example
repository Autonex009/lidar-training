# ---- Database ----------------------------------------------------------------
# SQLite by default (path is relative to prisma/schema.prisma). For Postgres change the
# `provider` in prisma/schema.prisma to "postgresql" and use e.g.
#   DATABASE_URL="postgresql://user:pass@host:5432/lidar?schema=public"
DATABASE_URL="file:./dev.db"

# ---- Auth.js -----------------------------------------------------------------
# REQUIRED. Signs session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="generate-with: openssl rand -base64 32"
# Lets Auth.js derive its URL from the request Host header, so `npm run dev` works on any port
# without setting AUTH_URL/NEXTAUTH_URL. Keep true behind a reverse proxy too. If you prefer a fixed
# public URL set AUTH_URL="https://portal.example.com" (do NOT set it for local dev).
AUTH_TRUST_HOST=true
# AUTH_URL=""

# ---- First-run bootstrap -----------------------------------------------------
# REQUIRED for /setup (creates the first ADMIN; works only while no ADMIN exists). Long random string.
SETUP_TOKEN="long-random-string-for-first-admin-bootstrap"

# ---- Registration ------------------------------------------------------------
# Comma-separated allowed email domains for self-registration. Empty = any domain.
ALLOWED_EMAIL_DOMAINS="example.com"
# Optional invite code required on the register form. Empty = none.
REGISTRATION_INVITE_CODE=""
# Slug of the TrainingProgram new users are enrolled in.
DEFAULT_PROGRAM_SLUG="foundations"

# ---- Hardening ---------------------------------------------------------------
# Max login attempts per IP per minute (in-memory, per process). Default 10.
# LOGIN_RATE_LIMIT_PER_MIN=10
